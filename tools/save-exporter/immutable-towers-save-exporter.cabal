cabal-version: 3.4
name: immutable-towers-save-exporter
version: 0.1.0.0
build-type: Simple

executable immutable-towers-save-exporter
  main-is: Main.hs
  other-modules:
      AccountStorage
      AccountTypes
      BotStrategy
      CatalogExport
      EnemySystem
      GameFactory
      ImmutableTowers
      MapData
      MetaTypes
      ProgressionSystem
      SaveSystem
      ShopSystem
      StableIds
      TowerRuntime
      TowerSystem
      WaveSystem
  hs-source-dirs: src, ../../app
  default-language: GHC2021
  ghc-options: -Wall
  build-depends:
      aeson >=2.2 && <2.3,
      base >=4.17 && <4.21,
      bytestring >=0.11 && <0.13,
      containers ^>=0.7,
      directory ^>=1.3,
      filepath ^>=1.5,
      gloss ^>=1.13.2.1,
      immutable-towers,
      time >=1.12 && <1.15
