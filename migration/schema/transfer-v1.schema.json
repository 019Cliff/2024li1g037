{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immutable-towers.local/schema/transfer-v1.schema.json",
  "title": "Immutable Towers Haskell to Godot transfer",
  "type": "object",
  "required": ["schema", "version", "source", "accounts", "warnings"],
  "properties": {
    "schema": { "const": "immutable-towers-transfer" },
    "version": { "const": 1 },
    "source": {
      "type": "object",
      "required": ["game", "exporter_version"],
      "properties": {
        "game": { "const": "haskell-gloss" },
        "exporter_version": { "type": "integer", "minimum": 1 },
        "exported_at_utc": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "legacy_global": { "type": ["object", "null"] },
    "account_index": { "type": ["object", "null"] },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["account_id", "profile"],
        "properties": {
          "account_id": { "$ref": "#/$defs/stableId" },
          "profile": { "type": "object" },
          "meta_progress": { "type": "object" },
          "leaderboard": { "type": "array" },
          "pending_run": { "type": ["object", "null"] }
        },
        "additionalProperties": true
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    }
  },
  "additionalProperties": true
}
